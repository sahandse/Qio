{
  "name": "qio",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "tauri": "tauri",
    "build:hook": "cargo build --release -p qio-hook",
    "build:app": "cargo build --release",
    "pack": "tauri build && node scripts/pack.mjs",
    "setup:claude": "node scripts/setup-claude.mjs",
    "setup:cursor": "node scripts/setup-cursor.mjs",
    "setup:qoder": "node scripts/setup-qoder.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}