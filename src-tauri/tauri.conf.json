{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qio",
  "version": "0.1.0",
  "identifier": "ir.qio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "کیو | Qio",
        "width": 390,
        "height": 610,
        "minWidth": 340,
        "minHeight": 500,
        "backgroundColor": "#101522",
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}